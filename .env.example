# Copy to .env and fill in. NEVER commit .env.
# On the server, real values live in AWS Secrets Manager.
# See docs/ENVIRONMENT.md.

# --- Product ---------------------------------------------------------------
PRODUCT_NAME=KanoonBuddy
CORPUS_COLLECTION=kanoon_v1
SNAPSHOT_VERSION=v2026.08
DATA_AS_OF=

# --- AI gateway (LiteLLM) --------------------------------------------------
# Only providers on no-training terms may appear here.
MODEL_FREE=gemini/gemini-2.5-flash-lite
MODEL_STUDENT=gemini/gemini-3.1-flash-lite
MODEL_PRO=gemini/gemini-3.1-flash-lite
MODEL_REWRITE=gemini/gemini-2.5-flash-lite
MODEL_FALLBACK=
GEMINI_API_KEY=

# --- Voyage AI -------------------------------------------------------------
VOYAGE_API_KEY=
VOYAGE_EMBED_MODEL=voyage-4
VOYAGE_RERANK_MODEL=rerank-2.5-lite

# --- Jev (TypeSafe AI) -----------------------------------------------------
JEV_API_KEY=
JEV_TIMEOUT_MS=800
JEV_GATE_THRESHOLD=0.6
JEV_ENABLED_SCOPE=false
JEV_ENABLED_FILTERS=false
JEV_ENABLED_GATE=false
JEV_ENABLED_CLAIM=false
JEV_ENABLED_SAFETY=false

# --- Qdrant ----------------------------------------------------------------
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=kanoon_v1
QDRANT_UPLOADS_COLLECTION=user_documents

# --- PostgreSQL / Redis ----------------------------------------------------
DATABASE_URL=postgresql+psycopg://kanoon:kanoon@postgres:5432/kanoon
REDIS_URL=redis://redis:6379/0
ANSWER_CACHE_TTL_DAYS=7

# --- AWS / S3 --------------------------------------------------------------
AWS_REGION=ap-south-1
S3_BUCKET_UPLOADS=
S3_BUCKET_BACKUPS=
S3_KMS_KEY_ID=

# --- Firebase (login only) -------------------------------------------------
FIREBASE_PROJECT_ID=
FIREBASE_CREDENTIALS_JSON=

# --- Razorpay --------------------------------------------------------------
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- Monitoring ------------------------------------------------------------
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=
SENTRY_DSN=

# --- Limits (undecided values left blank on purpose) -----------------------
PLAN_LIMIT_FREE=
PLAN_LIMIT_STUDENT=
PLAN_LIMIT_PRO=
PLAN_LIMIT_CHAMBERS=
UPLOAD_MAX_MB=
UPLOAD_MAX_PAGES=

# --- Feature switches (all off at launch) ----------------------------------
FEATURE_UPLOADS=false
FEATURE_STATS_LIVE=false
FEATURE_MODEL_ROUTING=false
FEATURE_HINDI=false
